<?xml version="1.0" encoding="utf-8"?>
<!-- White medication pill (tilted) with a dark-blue check = taken/adherence -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Pill body: horizontal capsule centered (54,58), tilted -32deg -->
    <group
        android:rotation="-32"
        android:pivotX="54"
        android:pivotY="58">
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M34,58 a11,11 0 0,1 11,-11 h18 a11,11 0 0,1 11,11 a11,11 0 0,1 -11,11 h-18 a11,11 0 0,1 -11,-11 z" />
        <!-- Check mark on the pill -->
        <path
            android:strokeColor="#1D4ED8"
            android:strokeWidth="4"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:fillColor="#00000000"
            android:pathData="M47,58 l5,5 l10,-12" />
    </group>
    <!-- Small shine dot (optional accent) -->
    <path
        android:fillColor="#4D000000"
        android:pathData="M46,42 a4,4 0 1,0 0.01,0 z" />
</vector>
