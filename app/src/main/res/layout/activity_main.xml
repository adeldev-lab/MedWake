<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="MedWake"
            app:titleTextColor="?attr/colorOnPrimary"
            android:background="?attr/colorPrimary" />

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorPrimary"
            app:tabTextColor="#B3FFFFFF"
            app:tabSelectedTextColor="?attr/colorOnPrimary"
            app:tabIndicatorColor="?attr/colorPrimaryContainer">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Today" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Meds" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="History" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Settings" />

        </com.google.android.material.tabs.TabLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Today Container (Scrollable) -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/containerToday"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                                <TextView
                    android:id="@+id/tvTodayHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Today's Schedule"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/on_surface" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvTodayEvents"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/tvEmptyToday"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No doses scheduled for today.\nTap + to add a medication."
                    android:gravity="center"
                    android:padding="24dp"
                    android:textColor="@color/text_secondary"
                    android:visibility="gone" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Meds Container (Scrollable) -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/containerMeds"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="My Medications"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/on_surface" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvMedications"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:layout_marginTop="8dp" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- History Container (Fully Scrollable Page) -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/containerHistory"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Monthly Adherence Calendar Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/card_stroke"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Custom Monthly Calendar Grid View -->
                        <org.wakegated.medication.ui.history.MonthlyAdherenceCalendarView
                            android:id="@+id/calendarViewAdherence"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />

                        <!-- Streak and Month Adherence Metrics -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:paddingBottom="14dp"
                            android:gravity="center_vertical">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvCurrentStreak"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Streak: 0 Days"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:textColor="#EA580C" />

                                <TextView
                                    android:id="@+id/tvAdherenceSubtitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0 Taken - 0 Skipped"
                                    android:textSize="11sp"
                                    android:textColor="@color/text_secondary"
                                    android:layout_marginTop="2dp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvAdherencePercentage"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="100%"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="#059669" />
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Dose History Section Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:id="@+id/tvHistoryHeader"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Dose History (All)"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/on_surface" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClearDateFilter"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="Show All"
                        android:textSize="11sp"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:visibility="gone" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Settings Container (Scrollable) -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/containerSettings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Alarm Themes & Personalization Card -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Alarm Appearance and Themes"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardElevation="2dp"
                    app:cardCornerRadius="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Color Theme"
                            android:textStyle="bold" />

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/cgAlarmThemes"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:singleSelection="true"
                            app:singleLine="false"
                            android:layout_marginTop="6dp">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipThemeElectricBlue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Electric Blue (Default)"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:checked="true" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipThemeEmerald"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Emerald Green"
                                style="@style/Widget.Material3.Chip.Filter" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipThemeMidnight"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Midnight Slate"
                                style="@style/Widget.Material3.Chip.Filter" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipThemeSunset"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Sunset Rose"
                                style="@style/Widget.Material3.Chip.Filter" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipThemeRoyal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Royal Purple"
                                style="@style/Widget.Material3.Chip.Filter" />
                        </com.google.android.material.chip.ChipGroup>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mascot / Background Mode"
                            android:textStyle="bold"
                            android:layout_marginTop="12dp" />

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/cgAlarmMascot"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:singleSelection="true"
                            app:singleLine="false"
                            android:layout_marginTop="6dp">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipMascotCustom"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Custom Wallpaper (Imported)"
                                style="@style/Widget.Material3.Chip.Filter" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipMascotRobot"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Pillo Robot Mascot"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:checked="true" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipMascotMinimal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Minimalist Theme"
                                style="@style/Widget.Material3.Chip.Filter" />
                        </com.google.android.material.chip.ChipGroup>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="12dp">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnPickCustomWallpaper"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.2"
                                android:text="Pick Wallpaper"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_marginEnd="4dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnClearCustomWallpaper"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Clear"
                                style="@style/Widget.Material3.Button.TextButton"
                                android:layout_marginEnd="4dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnPreviewAlarmScreen"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Preview"
                                style="@style/Widget.Material3.Button.TonalButton" />
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Audio & Gentle Volume Section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Audio and Gentle Volume"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary"
                    android:layout_marginTop="20dp" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardElevation="2dp"
                    app:cardCornerRadius="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchGentleVolume"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Gentle Volume Ramp-Up (Fade-In)"
                            android:textStyle="bold"
                            android:checked="true" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Starts very quiet (5% volume) and smoothly fades in to full volume so you are never startled awake."
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:layout_marginTop="2dp" />

                        <TextView
                            android:id="@+id/tvGentleVolumeDurationLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Fade-in duration: 15 seconds"
                            android:textStyle="bold"
                            android:layout_marginTop="12dp" />

                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderGentleVolume"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:valueFrom="5"
                            android:valueTo="30"
                            android:stepSize="5"
                            android:value="15" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPreviewGentleVolume"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Test Volume Fade-In"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_marginTop="4dp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Wake-Gated Preferences Section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Wake-Gated Preferences"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary"
                    android:layout_marginTop="20dp" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardElevation="2dp"
                    app:cardCornerRadius="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Unlock Delay Mode"
                            android:textStyle="bold" />

                        <RadioGroup
                            android:id="@+id/rgDelayMode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp">

                            <RadioButton
                                android:id="@+id/rbDelayRandom"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Random delay"
                                android:checked="true" />

                            <RadioButton
                                android:id="@+id/rbDelayFixed"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Fixed delay" />

                            <RadioButton
                                android:id="@+id/rbDelayImmediate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Immediate (0s)" />
                        </RadioGroup>

                        <TextView
                            android:id="@+id/tvDelaySecondsLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Delay seconds (max 120): 7"
                            android:layout_marginTop="8dp" />

                        <!-- FIX 4: Numeric EditText replacing the old slider (0-120s) -->
                        <EditText
                            android:id="@+id/etUnlockDelaySeconds"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:maxLength="3"
                            android:hint="e.g. 90"
                            android:text="7"
                            android:layout_marginTop="4dp" />
                        <!-- Snooze minutes -->
                        <TextView
                            android:id="@+id/tvSnoozeMinutesLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Snooze minutes (1-120): 10"
                            android:layout_marginTop="12dp" />

                        <EditText
                            android:id="@+id/etSnoozeMinutes"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:maxLength="3"
                            android:hint="e.g. 10"
                            android:text="10"
                            android:layout_marginTop="4dp" />


                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- When MedWake Rings Info Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardElevation="2dp"
                    app:cardCornerRadius="12dp"
                    app:cardBackgroundColor="#FFF8E1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="When MedWake Rings"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorPrimary" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="MedWake rings: (1) a non-wake-gated medication reaches its time (locked or not); (2) a wake-gated dose is due while the phone is unlocked and in use; (3) a wake-gated dose became due while locked and you unlock the phone; (4) quick-open catch-up, if enabled; (5) safety net, if enabled; (6) a dose already ringing resumes after an app restart. It never rings when the screen turns on while locked (phone alarm, notification, power button)."
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:layout_marginTop="4dp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Quick-Open Catch-Up Section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quick-Open Catch-Up"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary"
                    android:layout_marginTop="20dp" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardElevation="2dp"
                    app:cardCornerRadius="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchQuickOpen"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Quick-open catch-up"
                            android:textStyle="bold"
                            android:checked="false" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="If you unlock your phone shortly after a dose is due, MedWake will ring even if you didn't unlock at the exact time."
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:layout_marginTop="2dp" />

                        <TextView
                            android:id="@+id/tvQuickOpenSecondsLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Minimum unlock duration seconds (5-120): 15"
                            android:textStyle="bold"
                            android:layout_marginTop="12dp" />

                        <EditText
                            android:id="@+id/etQuickOpenSeconds"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:maxLength="3"
                            android:hint="e.g. 15"
                            android:text="15"
                            android:layout_marginTop="4dp" />

                        <!-- Usage Access Row -->
                        <TextView
                            android:id="@+id/tvUsageAccessStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Usage Access: Checking..."
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:layout_marginTop="16dp" />

                        <TextView
                            android:id="@+id/tvUsageAccessHint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Without usage access, ring decisions rely on a less reliable phone signal — grant it for precise ring-only-on-unlock behavior and catch-up."
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:layout_marginTop="2dp"
                            android:visibility="gone" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnUsageAccess"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Grant Usage Access"
                            android:layout_marginTop="8dp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Safety Net Section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Safety Net: Ring While Locked"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary"
                    android:layout_marginTop="20dp" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardElevation="2dp"
                    app:cardCornerRadius="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchSafetyNet"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Safety net: ring while locked"
                            android:textStyle="bold"
                            android:checked="false" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="After the safety-net duration, MedWake will ring even if the phone is locked. Useful for ensuring critical doses are not missed."
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:layout_marginTop="2dp" />

                        <TextView
                            android:id="@+id/tvSafetyNetMinutesLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Safety net minutes (10-300): 30"
                            android:textStyle="bold"
                            android:layout_marginTop="12dp" />

                        <EditText
                            android:id="@+id/etSafetyNetMinutes"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:maxLength="3"
                            android:hint="e.g. 30"
                            android:text="30"
                            android:layout_marginTop="4dp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Ring Decision Log Debug Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardElevation="2dp"
                    app:cardCornerRadius="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnViewRingLog"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Ring Decision Log (Debug)"
                            style="@style/Widget.Material3.Button.OutlinedButton" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- System & Reliability Section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="System and Reliability"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary"
                    android:layout_marginTop="20dp" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardElevation="2dp"
                    app:cardCornerRadius="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvExactAlarmStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Exact Alarms: Checking..."
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnExactAlarmPermission"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Grant Exact Alarm Permission"
                            android:layout_marginTop="8dp" />

                        <TextView
                            android:id="@+id/tvFullScreenStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Full-Screen Intent: Granted"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:layout_marginTop="16dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnFullScreenPermission"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Manage Full-Screen Intent"
                            android:layout_marginTop="8dp" />

                        <TextView
                            android:id="@+id/tvBatteryOptimizationStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Battery Optimization: Checking..."
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:layout_marginTop="16dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="On Samsung (One UI) devices, battery exemption ensures morning alarms never get killed in deep sleep."
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:layout_marginTop="2dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnBatteryOptimization"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Exempt Battery Optimization"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_marginTop="8dp" />

                        <TextView
                            android:id="@+id/tvOverlayStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Display over other apps: Checking..."
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:layout_marginTop="16dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Lets the alarm re-appear over other apps while ringing"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:layout_marginTop="2dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnOverlayPermission"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Grant Overlay Permission"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_marginTop="8dp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Backup & Restore Section -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Backup and Restore"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary"
                    android:layout_marginTop="20dp" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardElevation="2dp"
                    app:cardCornerRadius="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnExportBackup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Export data"
                            style="@style/Widget.Material3.Button.OutlinedButton" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRestoreBackup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Restore data"
                            android:layout_marginTop="8dp"
                            style="@style/Widget.Material3.Button.OutlinedButton" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>


            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </FrameLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddMedication"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:src="@android:drawable/ic_input_add"
        app:tint="?attr/colorOnPrimary"
        app:backgroundTint="?attr/colorPrimary"
        android:contentDescription="Add Medication" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
